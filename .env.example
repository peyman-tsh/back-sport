PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/headlight_db
MONGODB_DB_NAME=headlight_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-64-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-refresh-secret
PAYMENT_CALLBACK_URL=http://localhost:4000/api/v1/orders/verify
ZARINPAL_MERCHANT_ID=replace-with-your-zarinpal-merchant-id
ZARINPAL_SANDBOX=true
ZARINPAL_AMOUNT_MULTIPLIER=10
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=replace-with-a-random-revalidation-secret
